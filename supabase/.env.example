# Secrets Edge Functions — set dengan:  supabase secrets set --env-file supabase/.env
# (JANGAN commit file .env asli. SUPABASE_URL / ANON / SERVICE_ROLE otomatis tersedia di Edge Functions.)

# WAJIB — kunci AES-256 (base64, 32 byte) untuk mengenkripsi OpenAI key di database:  openssl rand -base64 32
SECRETS_ENC_KEY=
# WAJIB (sementara) — rahasia pemanggil fungsi bootstrap, min 16 karakter:  openssl rand -hex 24
BOOTSTRAP_SECRET=
# DISARANKAN — pepper hash token lisensi. JANGAN diubah setelah ada token yang diterbitkan:  openssl rand -hex 24
TOKEN_PEPPER=

# OPSIONAL
EMAIL_DOMAIN=aisp.example.com     # harus sama dengan EMAIL_DOMAIN di config/dart_defines.json
TZ_OFFSET_HOURS=7                 # batas hari kuota harian (WIB=7)
# OPENAI_API_KEY=                 # cadangan bila admin belum mengatur key dari aplikasi
# BOOTSTRAP_ADMIN_USERNAME=admin  # default admin
# BOOTSTRAP_ADMIN_PASSWORD=Riyan.123  # default sesuai permintaan; WAJIB diganti saat login pertama
